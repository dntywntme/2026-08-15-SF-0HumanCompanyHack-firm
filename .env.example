# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# SECRET DISCIPLINE FOR THIS PROJECT
# The dashboard is a static page on GitHub Pages, so it can hold NO secrets.
# Anything here is read server-side only (Render Workflow / GitHub Action), which
# writes runs/ledger.json for the page to consume. If a value below would ever
# reach the browser, that is a bug.


# ─── Terac (MANDATORY GATE) ────────────────────────────────────────────────────
# Preferred path is MCP over OAuth, which needs NO key here:
#   claude mcp add --transport http terac https://terac.com/api/mcp
#   then /mcp in-session to authenticate.
# These are only for the REST fallback (flagged beta; shapes may change).
# The base is read at call time and must be https: adapters refuse any other
# scheme before opening it, so a redirected base cannot become a file read.
TERAC_API_BASE=https://terac.com/api/external/v2
TERAC_API_KEY=
# expected_days_to_complete has a 5-DAY MINIMUM (default 7). That is the study
# deadline, not the turnaround — responses arrive as they arrive. Launch early.
TERAC_EXPECTED_DAYS=5
TERAC_AUDIENCE=general_population
TERAC_SAMPLE_SIZE=5
# Must be a PUBLIC https URL — participants open it. localhost will not work.
TERAC_TASK_URL=https://dntywntme.github.io/2026-08-15-SF-0HumanCompanyHack-firm/


# ─── Stripe (GATES BOTH $2,500 MAIN PRIZES) ───────────────────────────────────
# One sandbox, one key, one Payment Link. The adversarial lane makes no Stripe
# calls at all -- its attacks are work orders, and free-riding means declining
# to pay -- so there is nothing to isolate and no second key to keep straight.
#
# Restricted key: Balance=Read, Charges=Read, everything else None.
# NEVER an sk_ secret key, here or anywhere in this repo.
STRIPE_RESTRICTED_KEY=
# One Payment Link reused for every transaction all day ("Customer chooses
# price"). Creating a second mid-event breaks the organizers' revenue tracking.
STRIPE_PAYMENT_LINK=
STRIPE_API_BASE=https://api.stripe.com/v1
# Real money committed to humans via Terac, reported alongside revenue so the
# published margin is revenue minus real spend rather than revenue minus zero.
# "Committed" not "paid": spent at launch, disbursed to each expert on approval.
COGS_COMMITTED_USD=9.00
# ─── Model providers ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Pioneer / Fastino open-weight models, used for the confidence classifier so the
# cheap decision does not run on a frontier model.
PIONEER_API_KEY=
PIONEER_API_BASE=https://api.pioneer.ai/v1
PIONEER_MODEL=Qwen/Qwen3-8B


# ─── Arize / Phoenix (tracing — NOT WIRED) ─────────────────────────────────────
# Deliberately unused today. The pipeline runs against recorded fixtures so that
# --replay stays byte-identical, which leaves almost no LLM spans to trace: a
# trace viewer pointed at this would render an empty dashboard. The Decisions
# panel already shows what a judge needs — each judgement, what it rejected, and
# what it cost — which is a better fit for the argument than spans and latency.
#
# Wire it when triage runs real model calls per order at volume; that is when
# token cost, latency percentiles and failure clustering start to earn their
# keep. Install: arize-phoenix + openinference-instrumentation (both install on
# musl).
ARIZE_API_KEY=
ARIZE_SPACE_ID=
ARIZE_PROJECT_NAME=broker
# Self-hosted collector, or app.phoenix.arize.com for the hosted one.
PHOENIX_COLLECTOR_ENDPOINT=

# ─── Optional sponsor integrations ─────────────────────────────────────────────
# Superserve: pausable sandboxes for long-running Terac polls.
SUPERSERVE_API_KEY=
# Band: agent coordination. Must be load-bearing — remove the room and it breaks.
BAND_API_KEY=
BAND_ROOM_ID=


# ─── Business rules (the interesting knobs) ────────────────────────────────────
# Below this confidence, triage buys human expertise instead of answering.
CONFIDENCE_THRESHOLD=0.65
# Markup applied to Terac cost of goods to set the customer price.
PRICE_MARKUP=2.0
MIN_PRICE_USD=0.50
MAX_PRICE_USD=1.00
# THE COGS-ATTACK DEFENCE. Never spend cost of goods before revenue is secured,
# and cap unpaid exposure per client. Set REQUIRE_PAYMENT_BEFORE_COGS=false only
# to demo the attack landing, then flip it back on camera.
REQUIRE_PAYMENT_BEFORE_COGS=true
MAX_UNPAID_COGS_PER_CLIENT_USD=4.50
MAX_TOTAL_COGS_USD=27.00


# ─── Harness limits (demo safety) ──────────────────────────────────────────────
# Read as the defaults for --max-turns / --stage-timeout / --run-id; the flags
# still win. A clean run costs 11 turns (nine stages, plus the model call in
# triage and the purchase in source), so the cap has to sit above that.
MAX_TURNS=16
STAGE_TIMEOUT_S=45
RUN_ID=demo
# Adapters return recorded fixtures instead of calling out, so --replay stays
# byte-identical and the demo survives a dead network.
REPLAY_MODE=false


# ─── Deployment (reference only — nothing reads these) ─────────────────────────
# Kept as the canonical addresses for a human setting the project up. The code
# never consults them: the published URLs live in the workflows and the docs, and
# a second copy that drifts is worse than no copy. CLIENT_REPO_URL pointed at a
# dead qte77 fork for two days precisely because nothing exercised it.
#
# Published surfaces, all static and credential-free:
#   /                     the dashboard
#   /legal.html           terms and privacy, cited by id on every deliverable
#   /offer.json           the machine-readable offer, derived from the last run
#   /runs/ledger.json     revenue, polled from Stripe
#   /runs/demo/           the committed run the dashboard renders
FIRM_PUBLIC_URL=https://dntywntme.github.io/2026-08-15-SF-0HumanCompanyHack-firm/
CLIENT_REPO_URL=https://github.com/dntywntme/2026-08-15-SF-0HumanCompanyHack-client
